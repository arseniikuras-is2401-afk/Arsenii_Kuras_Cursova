/* Оформлення застосунку «Автосервіс».
   Токени @назва замінюються кольорами з ui/theme.py під час запуску. */

QWidget {
    color: @text;
    font-size: 10pt;
}

QMainWindow, QDialog, #PageRoot, QStackedWidget#Pages {
    background: @bg;
}

QToolTip {
    background: @sidebar;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
    border-radius: 4px;
}

/* ---------- бічна панель ---------- */

#Sidebar {
    background: @sidebar;
}

#Sidebar QLabel {
    color: @sidebar_text;
    background: transparent;
}

#BrandTitle {
    color: #FFFFFF;
    font-size: 13pt;
    font-weight: 600;
}

#BrandSubtitle, #SidebarFooter {
    color: @faint;
    font-size: 8.5pt;
}

#SidebarAuthor {
    color: #FFFFFF;
    font-size: 9pt;
    font-weight: 600;
}

QPushButton#NavButton {
    background: transparent;
    color: @sidebar_text;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    padding: 9px 14px 9px 13px;
    text-align: left;
    font-size: 10pt;
}

QPushButton#NavButton:hover {
    background: @sidebar_hover;
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background: @sidebar_active;
    color: #FFFFFF;
    border-left: 3px solid @accent_bright;
    font-weight: 600;
}

QPushButton#AboutButton {
    background: transparent;
    color: @sidebar_text;
    border: 1px solid #343C50;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 9pt;
}

QPushButton#AboutButton:hover {
    color: #FFFFFF;
    border-color: @sidebar_text;
}

/* ---------- заголовки й тексти ---------- */

QLabel[role="pageTitle"] {
    font-size: 17pt;
    font-weight: 600;
}

QLabel[role="sectionTitle"] {
    font-size: 11pt;
    font-weight: 600;
}

QLabel[role="muted"] {
    color: @muted;
}

QLabel[role="hint"] {
    color: @muted;
    font-size: 9pt;
}

QLabel[role="fieldError"] {
    color: @danger;
    font-size: 9pt;
}

QLabel[role="banner"] {
    background: @danger_soft;
    color: @danger;
    border: 1px solid #F5C2C2;
    border-radius: 6px;
    padding: 8px 10px;
}

QLabel[role="info"] {
    background: @accent_faint;
    color: @accent_hover;
    border: 1px solid @accent_soft;
    border-radius: 6px;
    padding: 7px 10px;
}

QLabel[role="emptyTitle"] {
    font-size: 12pt;
    font-weight: 600;
    color: @text;
}

/* ---------- картки ---------- */

QFrame[card="true"] {
    background: @surface;
    border: 1px solid @border;
    border-radius: 8px;
}

QFrame[card="true"] QLabel {
    background: transparent;
}

QFrame#MetricCard {
    background: @surface;
    border: 1px solid @border;
    border-radius: 8px;
}

QFrame#MetricCard[alert="true"] {
    background: @danger_soft;
    border-color: #F5C2C2;
}

QLabel#MetricValue {
    font-size: 19pt;
    font-weight: 600;
}

QFrame#MetricCard[alert="true"] QLabel#MetricValue {
    color: @danger;
}

QLabel#MetricCaption {
    color: @muted;
    font-size: 9pt;
}

QLabel#TotalValue {
    font-size: 16pt;
    font-weight: 700;
}

QLabel#OrderTitle {
    font-size: 16pt;
    font-weight: 600;
}

/* ---------- кнопки ---------- */

QPushButton {
    background: @surface;
    color: @text;
    border: 1px solid @border_strong;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background: @surface_alt;
    border-color: @faint;
}

QPushButton:pressed {
    background: @border;
}

QPushButton:disabled {
    color: @faint;
    background: @surface_alt;
    border-color: @border;
}

QPushButton[variant="primary"] {
    background: @accent;
    color: #FFFFFF;
    border: 1px solid @accent;
    font-weight: 600;
}

QPushButton[variant="primary"]:hover {
    background: @accent_hover;
    border-color: @accent_hover;
}

QPushButton[variant="primary"]:disabled {
    background: #E9B8A0;
    border-color: #E9B8A0;
    color: #FFFFFF;
}

QPushButton[variant="danger"] {
    color: @danger;
    border-color: #EBB4B4;
}

QPushButton[variant="danger"]:hover {
    background: @danger_soft;
    border-color: @danger;
}

QPushButton[variant="danger"]:disabled {
    color: @faint;
    background: @surface_alt;
    border-color: @border;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    color: @muted;
    padding: 6px 8px;
}

QPushButton[variant="ghost"]:hover {
    background: @border;
    color: @text;
}

QPushButton[variant="ghost"]:disabled {
    background: transparent;
    color: @border_strong;
}

QPushButton[segment="true"] {
    border-radius: 0;
    padding: 5px 16px;
    background: @surface;
}

QPushButton[segment="true"][first="true"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QPushButton[segment="true"][last="true"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton[segment="true"]:checked {
    background: @accent_soft;
    color: @accent_hover;
    border-color: @accent;
    font-weight: 600;
}

QPushButton#SortDirection {
    padding: 4px 6px;
    min-width: 22px;
}

/* ---------- поля введення ---------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit {
    background: @surface;
    border: 1px solid @border_strong;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: @accent_soft;
    selection-color: @text;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QPlainTextEdit:focus {
    border: 1px solid @accent;
}

QLineEdit[invalid="true"], QComboBox[invalid="true"],
QSpinBox[invalid="true"], QDoubleSpinBox[invalid="true"],
QDateEdit[invalid="true"], QPlainTextEdit[invalid="true"] {
    border: 1px solid @danger;
    background: @danger_soft;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDateEdit:disabled, QPlainTextEdit:read-only {
    background: @surface_alt;
    color: @muted;
}

QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url(@icons/chevron_down.svg);
    width: 12px;
    height: 12px;
}

QDateEdit::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: @surface;
    border: 1px solid @border_strong;
    selection-background-color: @accent_soft;
    selection-color: @text;
    outline: none;
    padding: 4px;
}

QSpinBox, QDoubleSpinBox {
    padding-right: 20px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(@icons/chevron_up.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(@icons/chevron_down.svg);
    width: 9px;
    height: 9px;
}

QCheckBox {
    spacing: 7px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @border_strong;
    border-radius: 4px;
    background: @surface;
}

QCheckBox::indicator:hover {
    border-color: @accent;
}

QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
    image: url(@icons/check.svg);
}

/* ---------- таблиці ---------- */

QTableView {
    background: @surface;
    alternate-background-color: @surface_alt;
    border: 1px solid @border;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: @accent_soft;
    selection-color: @text;
    outline: none;
}

QTableView::item {
    padding: 0 8px;
    border-bottom: 1px solid #EEF0F3;
}

QTableView::item:selected {
    background: @accent_soft;
    color: @text;
}

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background: @surface;
    color: @muted;
    font-size: 9pt;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid @border;
    padding: 8px 8px;
}

QHeaderView::section:hover {
    color: @text;
}

QTableCornerButton::section {
    background: @surface;
    border: none;
}

/* ---------- вкладки ---------- */

QTabWidget::pane {
    border: 1px solid @border;
    border-radius: 8px;
    background: @surface;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: @muted;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: @text;
}

QTabBar::tab:selected {
    color: @accent_hover;
    border-bottom: 2px solid @accent;
}

/* ---------- прокрутка й розділювачі ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: @border_strong;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: @border_strong;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:hover {
    background: @faint;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QSplitter::handle {
    background: transparent;
}

QScrollArea {
    border: none;
    background: transparent;
}

/* ---------- сповіщення ---------- */

QLabel#Toast {
    background: @sidebar;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 10px 16px;
}

QMessageBox {
    background: @surface;
}

QMessageBox QLabel#qt_msgbox_label {
    min-width: 320px;
}
